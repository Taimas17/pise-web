APP_NAME="PISE"
APP_ENV=production
# Generate with: php artisan key:generate --show
APP_KEY=base64:CHANGEME==
APP_DEBUG=false
APP_URL=https://api.votredomaine.com
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pise_prod
DB_USERNAME=pise_user
# Use a strong unique password
DB_PASSWORD=CHANGEME_STRONG_PASSWORD

# Use 'database' cache in production (table created by: php artisan migrate)
CACHE_STORE=database

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=.votredomaine.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=app.votredomaine.com

CORS_ALLOWED_ORIGINS=https://app.votredomaine.com

FILESYSTEM_DISK=public

REPORT_MAX_PHOTOS=5
REPORT_MAX_PHOTO_MB=5
REPORTS_RATE_LIMIT_PER_MIN=20
REPORTS_RATE_LIMIT_PER_HOUR=200

# Generate with: php -r "echo 'base64:'.base64_encode(random_bytes(32));"
COLUMN_ENCRYPTION_KEY=base64:CHANGEME==

PRIVACY_RETENTION_MONTHS=24
PRIVACY_PRECISION_MASK=3

KOBO_BASE_URL=
KOBO_TOKEN=
KOBO_FORM_IDS=
