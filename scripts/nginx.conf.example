# =============================================================================
# PISE — Configuration Nginx (domaine unique : paperlabbj.com)
#
# Architecture monodomaine :
#   paperlabbj.com/          → Frontend React SPA  (web/dist/)
#   paperlabbj.com/api/*     → Backend Laravel API (backend/public/)
#   paperlabbj.com/sanctum/* → Sanctum CSRF        (backend/public/)
#   paperlabbj.com/storage/* → Fichiers uploadés   (backend/storage/app/public/)
#
# Avantage : même origine → zéro problème CORS, cookies session simplifiés.
# =============================================================================

server {
    listen 443 ssl http2;
    server_name paperlabbj.com;

    # ── TLS (Let's Encrypt via Certbot) ─────────────────────────────────────
    ssl_certificate     /etc/letsencrypt/live/paperlabbj.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/paperlabbj.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;

    # ── Sécurité ─────────────────────────────────────────────────────────────
    add_header X-Content-Type-Options  "nosniff"                         always;
    add_header X-Frame-Options         "DENY"                            always;
    add_header Referrer-Policy         "strict-origin-when-cross-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Limite upload (photos signalements)
    client_max_body_size 25M;

    # ── Backend — Laravel (API + Sanctum + health check) ─────────────────────
    # Toutes les requêtes /api/*, /sanctum/*, /up sont routées vers Laravel.
    # Laravel's index.php gère le routage interne — pas besoin de try_files.
    location ~ ^/(api|sanctum|up)(/.*)?$ {
        fastcgi_pass        unix:/var/run/php/php8.2-fpm.sock;
        fastcgi_index       index.php;
        fastcgi_param       SCRIPT_FILENAME /var/www/pise-web/backend/public/index.php;
        fastcgi_param       DOCUMENT_ROOT   /var/www/pise-web/backend/public;
        fastcgi_param       REQUEST_URI     $request_uri;
        fastcgi_param       PHP_VALUE       "upload_max_filesize=25M \n post_max_size=25M";
        include             fastcgi_params;
    }

    # ── Fichiers uploadés (storage) ─────────────────────────────────────────
    # Expose les fichiers de backend/storage/app/public/ via /storage/
    location /storage/ {
        alias   /var/www/pise-web/backend/storage/app/public/;
        expires 30d;
        add_header Cache-Control "public";
        access_log off;
    }

    # ── Frontend — React SPA ──────────────────────────────────────────────────
    location / {
        root  /var/www/pise-web/web/dist;
        index index.html;

        # SPA routing : routes inconnues → index.html
        try_files $uri $uri/ /index.html;

        # HTML — jamais en cache
        location = /index.html {
            add_header Cache-Control "no-cache, no-store, must-revalidate";
        }

        # Assets hashés (JS/CSS/images) — cache 1 an
        location ~* \.(?:js|css|woff2?|ttf|eot|svg|png|jpg|jpeg|gif|ico|webp|webmanifest)$ {
            expires 1y;
            add_header Cache-Control "public, immutable";
            access_log off;
        }
    }

    # ── Bloquer les fichiers sensibles ───────────────────────────────────────
    location ~ /\.ht  { deny all; }
    location ~ /\.env { deny all; }
}

# ── Redirection HTTP → HTTPS ─────────────────────────────────────────────────
server {
    listen 80;
    server_name paperlabbj.com;
    return 301 https://$host$request_uri;
}
