# ─── Production frontend configuration ──────────────────────────────────────
# Copy to .env for the build: cp .env.production.example .env
# Then run: npm run build

# Frontend and backend share paperlabbj.com (no subdomain).
# Nginx routes /api/* and /sanctum/* to Laravel, everything else to the SPA.
# The frontend appends /api automatically (see src/lib/api.ts).
VITE_API_URL=https://paperlabbj.com

VITE_APP_TITLE=PISE

VITE_ENV=production
