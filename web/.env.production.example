# ─── Production frontend configuration ──────────────────────────────────────
# Copy to .env for the build: cp .env.production.example .env
# Then run: npm run build

# Backend API URL — must match APP_URL in backend .env (no trailing slash)
VITE_API_URL=https://api.paperlabbj.com

VITE_APP_TITLE=PISE

VITE_ENV=production
